#!/bin/sh
#
# Keep the design overview's date stamp honest and its PDF snapshot in step with the
# markdown, in the same commit.
#
# Runs only when the design overview itself is staged, so ordinary commits pay nothing.
#
#   git config hooks.designpdf false     disable without deleting the hook
#   git config hooks.designpdf.snapshot true   also keep a dated copy under docs/snapshots/
#
# Installed by setting core.hooksPath to this directory, so the hook is version
# controlled and every clone gets it. See docs/ or the repo README.

set -e

DOC="docs/design-overview.md"
PDF="docs/design-overview.pdf"
RENDERER=".githooks/md_to_pdf.py"

if [ "$(git config --bool hooks.designpdf || echo true)" = "false" ]; then
    exit 0
fi

# Nothing to do unless this commit actually touches the overview.
git diff --cached --name-only --diff-filter=ACM | grep -qx "$DOC" || exit 0

cd "$(git rev-parse --show-toplevel)"
[ -f "$RENDERER" ] || { echo "pre-commit: $RENDERER missing; skipping PDF." >&2; exit 0; }

PYTHON=""
for candidate in python3 python py; do
    if command -v "$candidate" >/dev/null 2>&1; then
        # `py` is the Windows launcher and needs a version flag; the others are used as-is.
        if [ "$candidate" = "py" ]; then
            PYTHON="py -3"
        else
            PYTHON="$candidate"
        fi
        break
    fi
done
[ -n "$PYTHON" ] || { echo "pre-commit: no python found; skipping PDF." >&2; exit 0; }

TODAY=$(date +%Y-%m-%d)

# Refresh the "Updated <date>" field in the document's stamp line. Only that one field
# is touched -- the revision letter is a human decision, not something a hook should
# guess at.
$PYTHON - "$DOC" "$TODAY" <<'PY'
import re, sys
path, today = sys.argv[1], sys.argv[2]
with open(path, encoding="utf-8") as fh:
    text = fh.read()
new, n = re.subn(
    r"(?m)^(\*\*Rev .*?· Updated )\d{4}-\d{2}-\d{2}",
    lambda m: m.group(1) + today,
    text,
    count=1,
)
if n and new != text:
    with open(path, "w", encoding="utf-8", newline="\n") as fh:
        fh.write(new)
    print(f"pre-commit: stamped {path} as updated {today}")
elif not n:
    print(f"pre-commit: no '** Rev ... - Updated <date>' stamp line in {path}; left alone")
PY

# The PDF is rendered from the staged content, which is what the commit will contain.
# `git branch --show-current` rather than `rev-parse --abbrev-ref HEAD`: the latter
# fails on an unborn branch, which is exactly the state of the very first commit, and
# `set -e` would then reject that commit.
BRANCH=$(git branch --show-current 2>/dev/null || true)
STAMP="Snapshot of $DOC · $TODAY · branch ${BRANCH:-(detached)}"
$PYTHON "$RENDERER" "$DOC" -o "$PDF" --stamp "$STAMP" || {
    echo "pre-commit: PDF render failed. Commit continues; the PDF is now stale." >&2
    git add "$DOC"
    exit 0
}

git add "$DOC" "$PDF"

if [ "$(git config --bool hooks.designpdf.snapshot || echo false)" = "true" ]; then
    mkdir -p docs/snapshots
    cp "$PDF" "docs/snapshots/design-overview-$TODAY.pdf"
    git add "docs/snapshots/design-overview-$TODAY.pdf"
fi

exit 0
